  "notes": [
    "Studio: Avatar → Graph Editor → Create Graph，按 nodes 搭完后 Publish，得到 rbxassetid。",
    "本文件不是引擎可加载资产。未改 Animate 业务代码；驱动仍由脚本 SetParameter。",
    "整图一条 AnimationTrack。Land 不再独占 Action 档；若业务 Idle 用 Action 会盖落地，P2 再拆。",
    "StopWalk 已接 Select 针 StopWalk（OnceAndHold）。现网 TransitionEnable.StopWalk=false，脚本暂不写该 LocoState；打开开关后即可播，无需改图。",
    "RunBack 与 WalkBack 当前共用同一 AssetId（Animation.luau 原样）。",
    "AirLean / ShiftLock 偏航 / ActionArbiter / FOV 不进图。"
  ],
  "parameters": [
    {
      "name": "LocoState",
      "type": "String",
      "default": "Idle",
      "values": ["Idle", "StartWalk", "Walk", "StartRun", "Run", "StopRun", "StopWalk", "Jump", "Fall", "Land", "LightLand", "Climb", "Swim", "SwimIdle"],
      "drive": "Select.Selection。值须等于 GroundLocomotion._pose / 现 BasePos。"
    },
    {
      "name": "MoveYawRad",
      "type": "Number",
      "default": 0,
      "unit": "studioDegrees_runtimeRadians",
      "drive": "Studio采样点是角度(0/90/180/-90)。运行时 SetParameter 必须 math.rad(-getMoveYaw())：弧度且左右取负。不要把度数直接喂图。"
    },
    {
      "name": "MoveMag",
      "type": "Number",
      "default": 1,
      "drive": "Walk/Run Blend2D.Y（Polar）。走跑态保持 1；换键归零时脚本 hold 上一 yaw，勿把 Mag 打到 0。"
    },
    {
      "name": "ClipSpeed",
      "type": "Number",
      "default": 1,
      "drive": "Walk/Run/Climb 外包 Speed 节点。Walk=speed/15、Run=speed/21、Climb=speed/20，再除 RigScale。"
    }
  ],
  "clips": {
